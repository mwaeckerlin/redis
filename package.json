{
  "name": "@mwaeckerlin/redis",
  "version": "1.0.0",
  "scripts": {
    "build": "docker compose build",
    "start": "docker compose up --build --force-recreate --remove-orphans",
    "start:daemon": "docker compose up -d --build --force-recreate --remove-orphans",
    "stop": "docker compose down",
    "test": "npm run test:image && npm run test:e2e",
    "test:image": "npm run build && bash tests/image-contract.sh mwaeckerlin/redis",
    "test:e2e": "bash tests/run.sh"
  }
}
